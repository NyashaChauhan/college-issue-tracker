# ============================================
# COLLEGE ISSUE TRACKER - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_tickets
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Secrets (use a strong random string for each, e.g. openssl rand -hex 64)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini (AI Grouping Layer)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (for email links)
COLLEGE_DOMAIN=http://localhost:3000
